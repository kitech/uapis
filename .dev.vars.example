# 复制为 .dev.vars 后填入真实值；.dev.vars 不要提交。
# 唯一使用 Worker Secret 的凭据：/admin/* 管理接口的 Bearer token。
ADMIN_TOKEN=change-me-local-dev-token
#
# 上游凭据不放在这里，统一存 D1 settings（见 /admin/settings）：
#   se.key  github.token  reddit.client_id  reddit.client_secret
#   youtube.key  ph.key  lastfm.key  telegram.token
#   zenrows.key  jina.key
