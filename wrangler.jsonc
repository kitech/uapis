{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uapis",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".assets",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uapis",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/[0-9]*.sql"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REFRESH",
        "queue": "uapis-refresh"
      }
    ],
    "consumers": [
      {
        "queue": "uapis-refresh",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["7 */2 * * *", "*/30 * * * *"]
  },
  // Free 计划不接受任何 limits 声明：只写 subrequests 也会被 API 拒绝，
  // 报 "CPU limits are not supported for the Free plan" [code: 100328]
  // 见 cloudflare/workers-sdk#8756。生效值回到计划默认：50 subrequests、10 ms CPU。
  // 注意 limits 是可继承字段，日后用 --env 时所有 env 段都得保持注释。
  // 升级 Workers Paid 后可放开：{ "cpu_ms": 30000, "subrequests": 1000 }
  // "limits": {
  //   "subrequests": 40
  // },
  "vars": {
    "SITE_NAME": "uapis"
  }
}
